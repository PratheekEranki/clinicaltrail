# Template only — copy to example.env and fill in real values. Never put real secrets here.

# NVIDIA
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Zetaris
ZETARIS_HOST=
ZETARIS_PORT=9993
ZETARIS_DATABASE=
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_DRIVER_PATH=

# Optional fallback LLM
OPENAI_API_KEY=

# Meterless
METERLESS_API_KEY=

# Runtime settings
LOG_LEVEL=INFO
LOG_DIR=logs
MAX_RETRY_COUNT=2
QUERY_TIMEOUT_SECONDS=10
